	"item": [
		{
			"name": "1. Authentication & Users",
			"item": [
				{
					"name": "1.1. Login as Admin",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.success && jsonData.data && jsonData.data.accessToken) {",
									"    pm.collectionVariables.set(\"adminToken\", jsonData.data.accessToken);",
									"    pm.collectionVariables.set(\"jwtToken\", jsonData.data.accessToken);",
									"    console.log(\"Saved adminToken & jwtToken: \" + jsonData.data.accessToken);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"admin\",\n    \"password\": \"Admin@123456!\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"login"
							]
						},
						"description": "Đăng nhập với tài khoản ADMIN mặc định. Tự động lưu vào biến `adminToken` và `jwtToken`."
					},
					"response": []
				},
