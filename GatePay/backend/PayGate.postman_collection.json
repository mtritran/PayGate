		{
			"name": "2. Merchant Onboarding & Approval Flow",
			"item": [
				{
					"name": "2.1. User - Request Merchant Registration",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.success && jsonData.data && jsonData.data.id) {",
									"    pm.collectionVariables.set(\"merchantId\", jsonData.data.id);",
									"    pm.collectionVariables.set(\"merchantCode\", jsonData.data.merchantCode);",
									"    console.log(\"Saved merchantId: \" + jsonData.data.id + \", code: \" + jsonData.data.merchantCode);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{merchantUserToken}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"merchantName\": \"Marketplace TechShop\",\n    \"merchantCode\": \"MP_TECHSHOP\",\n    \"webhookUrl\": \"http://localhost:8082/api/paygate-webhook\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/merchants/request",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"merchants",
								"request"
							]
						},
						"description": "User chủ shop gửi yêu cầu đăng ký Merchant (Trạng thái ban đầu: PENDING_APPROVAL). Tự động lưu `merchantId`."
					},
					"response": []
				},
				{
					"name": "2.2. Admin - Approve Merchant Request",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{adminToken}}",
									"type": "string"
								}
							]
						},
						"method": "PUT",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/admin/merchants/{{merchantId}}/approve",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"admin",
								"merchants",
								"{{merchantId}}",
								"approve"
							]
						},
						"description": "Admin duyệt yêu cầu Merchant. Hệ thống tự động kích hoạt ACTIVE và tạo Ví MERCHANT."
					},
					"response": []
				},
				{
					"name": "2.3. User - Get My Merchant API Key",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.success && jsonData.data) {",
									"    pm.collectionVariables.set(\"apiKey\", jsonData.data);",
									"    console.log(\"Saved apiKey: \" + jsonData.data);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{merchantUserToken}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/merchants/me/api-key",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"merchants",
								"me",
								"api-key"
							]
						},
						"description": "Chủ Shop lấy raw API Key sau khi được duyệt. Tự động lưu vào biến `apiKey` để dùng cho Checkout & Refund."
					},
					"response": []
				},
				{
					"name": "2.4. (Fast Track) Admin - Create Merchant Directly",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.success && jsonData.data && jsonData.data.id) {",
									"    pm.collectionVariables.set(\"merchantId\", jsonData.data.id);",
									"    pm.collectionVariables.set(\"merchantCode\", jsonData.data.merchantCode);",
									"    console.log(\"Saved merchantId: \" + jsonData.data.id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{adminToken}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"userId\": 1,\n    \"merchantName\": \"Marketplace FastShop\",\n    \"merchantCode\": \"MP_FASTSHOP\",\n    \"webhookUrl\": \"http://localhost:8082/api/paygate-webhook\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/admin/merchants",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"admin",
								"merchants"
							]
						},
						"description": "Admin tạo thẳng Merchant kích hoạt ngay mà không cần qua luồng duyệt."
					},
					"response": []
				},
				{
					"name": "2.5. Admin - Get Raw API Key",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.success && jsonData.data) {",
									"    pm.collectionVariables.set(\"apiKey\", jsonData.data);",
									"    console.log(\"Saved apiKey: \" + jsonData.data);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{adminToken}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/admin/merchants/{{merchantId}}/api-key",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"admin",
								"merchants",
								"{{merchantId}}",
								"api-key"
							]
						},
						"description": "Admin lấy unmasked raw API Key của Merchant. Tự động lưu vào biến `apiKey`."
					},
					"response": []
				}
			]
		},
