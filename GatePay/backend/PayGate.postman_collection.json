								"{{transactionRef}}"
							]
						},
						"description": "Tra cứu thông tin Checkout Session theo transactionRef."
					},
					"response": []
				},
				{
					"name": "4.5. Customer - Send OTP For Checkout Payment",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{customerToken}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"action\": \"Xác thực thanh toán đơn hàng\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/otp/send",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"otp",
								"send"
							]
						},
						"description": "Gửi mã OTP 6 chữ số về Email của người dùng trước khi bấm xác nhận thanh toán PayGate."
					},
					"response": []
				},
				{
					"name": "4.6. Customer - Authenticate OTP & Complete Checkout Payment",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
