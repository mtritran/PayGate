		{
			"name": "4. Feature-00: Checkout Gateway (PayGate & VietQR)",
			"item": [
				{
					"name": "4.1. MarketPlace - Create Checkout Session (PayGate Wallet)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.success && jsonData.data && jsonData.data.token) {",
									"    pm.collectionVariables.set(\"checkoutToken\", jsonData.data.token);",
									"    console.log(\"Saved checkoutToken: \" + jsonData.data.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"apiKey\": \"{{apiKey}}\",\n    \"orderId\": \"ORD-100234\",\n    \"amount\": 250000.00,\n    \"description\": \"Payment for order #ORD-100234 via PayGate Wallet\",\n    \"paymentMethod\": \"PAYGATE\",\n    \"returnUrl\": \"http://localhost:8082/?callback=true\",\n    \"cancelUrl\": \"http://localhost:8082/?cancel=true\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/checkout/create",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"checkout",
								"create"
							]
						},
						"description": "MarketPlace tạo phiên thanh toán qua Ví PayGate. Trả về paymentUrl và token (tự động lưu vào `checkoutToken`)."
					},
					"response": []
				},
