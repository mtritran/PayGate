					},
					"response": []
				},
				{
					"name": "4.3. Customer/Frontend - Get Checkout Info By Token",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/checkout/info/{{checkoutToken}}",
							"host": [
