# k6 does not load this file automatically. Export these values in the shell that starts k6.
BASE_URL=http://localhost:8081

# GD3: one fresh logical payment per run; every VU uses this exact same key.
GD3_RUN_ID=20260811-example
PAYGATE_USERNAME=
PAYGATE_PASSWORD=
ADMIN_USERNAME=
ADMIN_PASSWORD=
DEST_ACCOUNT_ID=
PAYMENT_AMOUNT=10000
IDEMPOTENCY_KEY=GD3-IDEM-20260811-example
GD3_VUS=10
GD3_BARRIER_SECONDS=3
GD3_SETTLEMENT_WAIT_SECONDS=15

# GD4: no secret defaults. Use only an isolated test database with a safe callback stub.
GD4_RUN_ID=20260811-example
GD4_TEST_ENV=isolated
GD4_ALLOW_MUTATION=false
GD4_CALLBACK_SAFE=false
WEBHOOK_SECRET=
MERCHANT_CODE=
MERCHANT_API_KEY=
CHECKOUT_AMOUNT=100000
GD4_RETURN_URL=
GD4_CANCEL_URL=
GD4_BANK_CODE=LOADTEST
GD4_ACCOUNT_NUMBER=LOADTEST-ACCOUNT
GD4_VALIDATION_VUS=30
GD4_VALIDATION_DURATION=60s
GD4_SETTLEMENT_VUS=30
GD4_SETTLEMENT_BARRIER_SECONDS=3
GD4_FORGED_VUS=10
GD4_FORGED_DURATION=15s
FORGED_AMOUNT=99999
